{
  "name": "bpl",
  "displayName": "BPMN-Lite",
  "description": "Live preview for BPMN-Lite DSL with syntax highlighting and real-time diagram rendering",
  "version": "0.4.38",
  "publisher": "oisee",
  "repository": {
    "type": "git",
    "url": "https://github.com/oisee/bpl.git",
    "directory": "vscode-bpmn-lite"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "bpmn",
    "diagram",
    "flowchart",
    "mermaid",
    "preview"
  ],
  "activationEvents": [
    "onLanguage:bpmn-lite"
  ],
  "main": "./out/extension.js",
  "browser": "./out/web/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "bpmn-lite",
        "aliases": [
          "BPMN-Lite",
          "bpmn-lite"
        ],
        "extensions": [
          ".bpl",
          ".bpmn-lite"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bpmn-lite",
        "scopeName": "source.bpmn-lite",
        "path": "./syntaxes/bpmn-lite.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bpmn-lite.showPreview",
        "title": "BPMN-Lite: Show Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "bpmn-lite.showPreviewToSide",
        "title": "BPMN-Lite: Show Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "bpmn-lite.exportMermaid",
        "title": "BPMN-Lite: Export as Mermaid"
      },
      {
        "command": "bpmn-lite.exportJSON",
        "title": "BPMN-Lite: Export as JSON (AST)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bpmn-lite.showPreview",
          "when": "resourceExtname == .bpl",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bpmn-lite.showPreviewToSide",
          "when": "resourceExtname == .bpl",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "bpmn-lite.showPreview",
          "when": "resourceExtname == .bpl"
        },
        {
          "command": "bpmn-lite.showPreviewToSide",
          "when": "resourceExtname == .bpl"
        }
      ]
    },
    "configuration": {
      "title": "BPMN-Lite",
      "properties": {
        "bpmn-lite.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open preview when opening .bpl files"
        },
        "bpmn-lite.preview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh preview when file changes"
        },
        "bpmn-lite.preview.refreshDelay": {
          "type": "number",
          "default": 300,
          "description": "Delay in milliseconds before refreshing preview"
        },
        "bpmn-lite.preview.openToSide": {
          "type": "boolean",
          "default": true,
          "description": "Always open preview to the side (split screen)"
        },
        "bpmn-lite.preview.theme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "dark",
            "forest",
            "neutral"
          ],
          "description": "Mermaid diagram theme"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:web",
    "compile": "tsc -p ./",
    "build:web": "node scripts/build-web.js",
    "watch": "tsc -watch -p ./",
    "build": "node scripts/build.js",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && npm run build:web && node test/test-suite.js && node test/test-parser-parity.js && node test/test-web.js",
    "test:host": "vscode-test-web --browser=chromium --esm --quality=stable --extensionDevelopmentPath=. --extensionTestsPath=out/web/test.js",
    "test:verbose": "npm run compile && node test/test-suite.js --verbose",
    "test:scenarios": "node test/test-reference-scenarios.js",
    "test:end": "node test/test-end-regression.js",
    "test:inventory": "node test/inventory.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-web": "^0.0.73",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.12",
    "mermaid": "^10.6.1",
    "typescript": "^4.9.3"
  }
}
